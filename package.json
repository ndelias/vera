{
  "name": "vera",
  "private": true,
  "license": "Apache-2.0",
  "description": "Vera: review for the AI era.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w panel",
    "test": "node --test --disable-warning=ExperimentalWarning \"packages/*/test/**/*.test.ts\" \"apps/panel/lib/**/*.test.ts\"",
    "ci": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3"
  }
}
